{
  "config": {
    "step": {
      "user": {
        "title": "Connect openGym",
        "description": "The address of your openGym instance, e.g. http://192.168.1.50:3000. This is the URL where openGym runs for you (browser address bar), not the GitHub project page.",
        "data": {
          "url": "URL"
        }
      },
      "pair": {
        "title": "Pair openGym",
        "description": "1. Create a code: in openGym go to Settings → Integrations → \"Pair the mobile app\", generate a pairing code and enter it here (valid 5 minutes).\n\n2. Set up the webhook (recommended so Home Assistant gets changes instantly instead of polling every {poll_interval} minutes): create a new webhook connection in openGym under Settings → Integrations → Webhooks pointing to:\n{webhook_url}\nEvents: {events}. Enter the signing secret shown there below.\n\nWithout a webhook the integration still works — data is just refreshed at the poll interval.",
        "data": {
          "code": "Pairing code",
          "name": "Name",
          "auto_webhook": "Set up webhook automatically",
          "secret": "Signing secret (optional)"
        }
      },
      "reauth_confirm": {
        "title": "openGym re-pair",
        "description": "The openGym session is no longer valid. Create a new pairing code in openGym (Settings → Integrations → \"Pair the mobile app\") and enter it here.",
        "data": {
          "code": "Pairing code"
        }
      }
    },
    "error": {
      "cannot_connect": "openGym is not reachable at this URL.",
      "invalid_code": "Code wrong or expired (valid 5 minutes).",
      "unknown": "Unexpected error, see the Home Assistant log."
    },
